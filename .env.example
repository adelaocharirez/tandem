# Copy to .env — every value is optional for local development.

# Port the server listens on.
PORT=8787

# Postgres connection string. Leave empty to use the embedded database
# (PGlite, stored in ./.data) — zero setup, fine for two people.
DATABASE_URL=

# The public URL people (and Claudes) reach this server at. Used to print
# correct connect commands in the dashboard. e.g. https://tandem.onrender.com
PUBLIC_URL=

# Set to "production" when deployed (secure cookies, static file serving).
NODE_ENV=development

# Who can create an account: "open" or "invite". With "invite", the first
# account on a fresh server is free (that's you) and everyone after needs a
# room invite link. Defaults to "invite" in production, "open" otherwise.
SIGNUP_MODE=
